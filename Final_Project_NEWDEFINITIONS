def meanReversionStrategy(prices, ticker, window=5, threshold=0.02):
    trades = []
    position = None  # 'long' or 'short'
    entry_price = 0
    entry_index = 0
    profit = 0
    first_buy_price = None

    for i in range(window, len(prices)):
        current_price = prices[i]
        moving_avg = sum(prices[i - window:i]) / window

        # Long Entry
        if position is None and current_price < moving_avg * (1 - threshold):
            position = 'long'
            entry_price = current_price
            entry_index = i
            if first_buy_price is None:
                first_buy_price = current_price
            print(f"Buy at: {round(current_price, 2)}")

        # Long Exit
        elif position == 'long' and current_price > moving_avg * (1 + threshold):
            trade_profit = current_price - entry_price
            profit += trade_profit
            hold_days = i - entry_index
            print(f"Sell at: {round(current_price, 2)} (Held for {hold_days} days)")
            print(f"Trade Profit = {round(trade_profit, 2)}")
            trades.append({'type': 'long', 'entry': entry_price, 'exit': current_price,
                           'days_held': hold_days, 'profit': trade_profit})
            position = None

        # Short Entry
        elif position is None and current_price > moving_avg * (1 + threshold):
            position = 'short'
            entry_price = current_price
            entry_index = i
            print(f"Short at: {round(current_price, 2)}")

        # Short Exit
        elif position == 'short' and current_price < moving_avg * (1 - threshold):
            trade_profit = entry_price - current_price
            profit += trade_profit
            hold_days = i - entry_index
            print(f"Cover at: {round(current_price, 2)} (Held for {hold_days} days)")
            print(f"Short Trade Profit = {round(trade_profit, 2)}")
            trades.append({'type': 'short', 'entry': entry_price, 'exit': current_price,
                           'days_held': hold_days, 'profit': trade_profit})
            position = None

    final_return_pct = round((profit / first_buy_price) * 100, 2) if first_buy_price else 0

    print("---------------------------------")
    print("Ticker:", ticker)
    print("Total profit:", round(profit, 2))
    print("First Buy:", round(first_buy_price, 2) if first_buy_price else "N/A")
    print("Percentage Return:", final_return_pct, "%\n")

    return profit, final_return_pct, trades


